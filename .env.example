# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Weather data is provided by Open-Meteo (open-meteo.com) — no API key needed!

# Your Gmail address (used as both sender AND recipient)
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Requires 2-Step Verification to be enabled on your account
# Generate at: https://myaccount.google.com/apppasswords
# Format: 16 characters, spaces are optional (e.g. "xxxx xxxx xxxx xxxx")
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
